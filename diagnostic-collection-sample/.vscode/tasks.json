{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"problemMatcher": {
				"owner": "typescript",
				"source": "ts",
				"applyTo": "closedDocuments",
				"fileLocation": ["relative", "${workspaceFolder}"],
				"pattern": "$tsc",
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[.*\\] (?:Starting compilation in watch mode\\.\\.\\.|File change detected\\. Starting incremental compilation\\.\\.\\.)",
					"endsPattern": "^\\[.*\\] Found 0 errors\\. Watching for file changes\\."
				}
			},
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem",
				"panel": "dedicated"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
