{
	"name": "github-enterprise-agent-sample",
	"displayName": "GitHub Enterprise Agent Sample",
	"description": "GitHub / GitHub Enterprise integration with a chat agent and NVIDIA + Mistral model providers. Works on desktop and web (vscode.dev).",
	"version": "0.0.1",
	"publisher": "vscode-samples",
	"engines": {
		"vscode": "^1.104.0"
	},
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Microsoft/vscode-extension-samples"
	},
	"categories": [
		"AI",
		"Chat",
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"browser": "./dist/web/extension.js",
	"contributes": {
		"chatParticipants": [
			{
				"id": "github-enterprise-agent-sample.agent",
				"fullName": "Enterprise Agent",
				"name": "enterprise-agent",
				"description": "GitHub / GitHub Enterprise agent. Ask about your orgs and repos, or just chat.",
				"isSticky": true,
				"commands": [
					{
						"name": "orgs",
						"description": "List the GitHub organizations you belong to"
					},
					{
						"name": "repos",
						"description": "List repositories of one of your organizations"
					}
				]
			}
		],
		"languageModelChatProviders": [
			{
				"vendor": "nvidia",
				"displayName": "NVIDIA NIM"
			},
			{
				"vendor": "mistral",
				"displayName": "Mistral AI"
			}
		],
		"commands": [
			{
				"command": "github-enterprise-agent-sample.openAgentChat",
				"title": "Open Enterprise Agent Chat",
				"category": "GitHub Enterprise Agent"
			},
			{
				"command": "github-enterprise-agent-sample.whoami",
				"title": "Show GitHub Account",
				"category": "GitHub Enterprise Agent"
			},
			{
				"command": "github-enterprise-agent-sample.listOrgRepos",
				"title": "List Organization Repositories",
				"category": "GitHub Enterprise Agent"
			},
			{
				"command": "github-enterprise-agent-sample.setNvidiaApiKey",
				"title": "Set NVIDIA API Key",
				"category": "GitHub Enterprise Agent"
			},
			{
				"command": "github-enterprise-agent-sample.setMistralApiKey",
				"title": "Set Mistral API Key",
				"category": "GitHub Enterprise Agent"
			}
		],
		"configuration": {
			"title": "GitHub Enterprise Agent",
			"properties": {
				"githubEnterpriseAgent.host": {
					"type": "string",
					"default": "https://github.com",
					"description": "GitHub host to connect to. Use https://github.com for GitHub.com, or your GitHub Enterprise Server URL (e.g. https://ghe.example.com). For GitHub Enterprise Server, also set the built-in \"github-enterprise.uri\" setting to the same URL so the github.enterprise authentication provider is registered."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run package-web",
		"download-api": "dts dev",
		"postdownload-api": "dts main",
		"postinstall": "npm run download-api",
		"compile": "tsc -p ./",
		"compile-web": "webpack",
		"watch": "tsc -watch -p ./",
		"watch-web": "webpack --watch",
		"package-web": "webpack --mode production --devtool hidden-source-map",
		"start-web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=.",
		"pretest": "npm run compile",
		"test": "node ./out/test/runTest.js",
		"lint": "eslint"
	},
	"dependencies": {
		"@octokit/rest": "^18.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/glob": "^7.1.1",
		"@types/mocha": "^10.0.1",
		"@types/node": "^22",
		"@types/vscode": "^1.104.0",
		"@vscode/dts": "^0.4.1",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/test-web": "^0.0.66",
		"assert": "^2.1.0",
		"eslint": "^9.13.0",
		"glob": "^7.1.4",
		"mocha": "^10.2.0",
		"process": "^0.11.10",
		"ts-loader": "^9.5.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0",
		"webpack": "^5.98.0",
		"webpack-cli": "^6.0.1"
	}
}
